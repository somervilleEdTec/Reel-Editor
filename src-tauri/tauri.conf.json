{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Reelwright",
  "mainBinaryName": "Reelwright",
  "version": "2.0.0",
  "identifier": "uk.co.somervilleedtec.reelwright",
  "build": {
    "frontendDist": "splash"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Reelwright",
        "url": "index.html",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": [],
    "icon": ["icons/icon.png", "icons/icon.ico"]
  }
}
